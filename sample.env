NEAR_CATALOG_API=https://api.nearcatalog.xyz
NEXT_PUBLIC_NEAR_CATALOG_API=https://api.nearcatalog.xyz

# Set to "false" to hide programmatic FAQ sections (and corresponding FAQPage JSON-LD).
# Defaults to enabled when unset.
NEXT_PUBLIC_FAQ_ENABLED=true

# IndexNow integration. Generate via: openssl rand -hex 32
# Hosted at /<INDEXNOW_KEY>.txt. Required by the daily cron at /api/cron/indexnow.
INDEXNOW_KEY=

# Bearer secret required by /api/cron/indexnow. Vercel Cron injects Authorization automatically.
CRON_SECRET=
